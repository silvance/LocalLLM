# Copy to .env and adjust as needed.
APP_ENV=dev
LOG_LEVEL=INFO

OLLAMA_HOST=http://localhost:11434

GRANITE_MODEL=granite4
GEMMA_MODEL=gemma4
QWEN_MODEL=qwen3-coder:30b

DEFAULT_MODEL=auto
DEFAULT_STREAM=true

TEMPERATURE=0.2
MAX_TOKENS=1024
NUM_CTX=32768

# RAG
RAG_ENABLED=false
RAG_INDEX_DIR=data/index
RAG_COLLECTION=corpus
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_RETRIEVAL_K=5
RAG_MAX_CONTEXT_CHARS=8000
RAG_MIN_QUERY_LEN=8

# RAG re-ranker (optional — adds one extra small-LLM call per retrieval)
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=granite4:tiny-h
RAG_RERANK_POOL=20
