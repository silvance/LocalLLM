# Copy to .env and adjust as needed.
APP_ENV=dev
LOG_LEVEL=INFO

OLLAMA_HOST=http://localhost:11434

GRANITE_MODEL=granite4
GEMMA_MODEL=gemma4
QWEN_MODEL=qwen3-coder:30b

DEFAULT_MODEL=auto
DEFAULT_STREAM=true

TEMPERATURE=0.2
MAX_TOKENS=8192
NUM_CTX=32768

# RAG
RAG_ENABLED=false
RAG_INDEX_DIR=data/index
RAG_COLLECTION=corpus
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_RETRIEVAL_K=8
RAG_MAX_CONTEXT_CHARS=8000
RAG_MIN_QUERY_LEN=8

# RAG re-ranker — on by default for the airgap target. Adds ~1-2 sec per
# retrieval (granite4:tiny-h is small) for noticeably better top-N quality.
# Set to false if latency is more important than citation precision.
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=granite4:tiny-h
RAG_RERANK_POOL=20

# Default system prompt sent on every chat turn unless overridden in the
# sidebar. Ships with a code-fencing reminder so qwen/gemma output renders
# correctly in Streamlit instead of autolinking dotted identifiers.
# Set to an empty string to send no system message by default.
# DEFAULT_SYSTEM_PROMPT="You are a coding assistant for security work..."
