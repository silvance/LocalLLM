# Local artifacts (RAG / models — populated later)
# Default-ignore everything under data/ except the operator-curated
# durable artifacts (ADRs etc.). User session state — chats/, reviews/,
# comparisons/, the outcomes log, and the auto-generated proposed/
# SITREP queue — stays out of the repo.
data/*
!data/durable/
data/durable/*
!data/durable/*.md
!data/durable/README.md
models/cache/
*.gguf

# Bundle output
dist/
build/

# Single-binary runtime data + downloaded vendor binaries
LocalLLM-Data/
vendor/ollama/

# Inno Setup installer output
installer/Output/
